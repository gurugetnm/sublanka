{
  "name": "sublanka",
  "version": "0.1.0",
  "private": true,
  "description": "Sinhala-first browser extension for discovering, translating, and displaying subtitles.",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode content --watch & vite build --mode development --watch",
    "build": "tsc && vite build && vite build --mode content",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gurugetnm/sublanka.git"
  },
  "bugs": {
    "url": "https://github.com/gurugetnm/sublanka/issues"
  },
  "homepage": "https://github.com/gurugetnm/sublanka#readme",
  "dependencies": {
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
